{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 19, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Debug)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "dev",
      "displayName": "Developer (warnings-as-errors + sanitizers)",
      "inherits": "default",
      "cacheVariables": {
        "CTEMPLATE_WARNINGS_AS_ERRORS": "ON",
        "CTEMPLATE_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "shared",
      "displayName": "Shared library build",
      "inherits": "default",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "release", "configurePreset": "release" },
    { "name": "dev", "configurePreset": "dev" },
    { "name": "shared", "configurePreset": "shared" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "inherits": "default"
    }
  ]
}
